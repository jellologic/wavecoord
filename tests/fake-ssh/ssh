#!/usr/bin/env python3
"""A fake `ssh` for tests. Stdlib only. It never opens a connection.

It parses ssh options, takes the first non-option word as the destination and
runs the rest of the words, joined by spaces (like ssh does), with `sh -c` on
this machine (like sshd runs it with the login shell). stdin, stdout, stderr
and the exit code pass through.

Environment:
  FAKE_SSH_LOG=<p>    append {"argv": [...], "dest": ..., "cmd": ...} as one JSON line per call
  FAKE_SSH_HOME=<d>   run the command with WAVECOORD_HOME=<d> (the "remote" wavecoord home)
  FAKE_SSH_DOWN=1     exit 255 (unreachable) without running anything
  FAKE_SSH_SHELL=<p>  the "login shell" that runs the command (default sh), for example /bin/csh
  FAKE_SSH_CUT=<n>    pass only the first n bytes of stdin, then EOF (a transfer cut short)
With -N (a tunnel), it logs the call and exits 0.
"""

import json
import os
import subprocess
import sys

WITH_VALUE = set("BbcDEeFIiJLlmOoPpQRSWw")


def main(argv):
    i, flags, dest = 0, [], None
    while i < len(argv):
        a = argv[i]
        if a.startswith("-") and len(a) > 1 and dest is None:
            letters = a[1:]
            for j, ch in enumerate(letters):
                if ch in WITH_VALUE:
                    if j == len(letters) - 1:
                        i += 1
                    break
                flags.append(ch)
            i += 1
            continue
        dest = a
        i += 1
        break
    cmd = " ".join(argv[i:])
    log = os.environ.get("FAKE_SSH_LOG")
    if log:
        with open(log, "a", encoding="utf-8") as f:
            f.write(json.dumps({"argv": argv, "dest": dest, "cmd": cmd, "flags": flags}) + "\n")
    if os.environ.get("FAKE_SSH_DOWN") == "1":
        sys.stderr.write("ssh: connect to host %s: Connection refused\n" % dest)
        return 255
    if dest is None:
        sys.stderr.write("usage: ssh destination [command]\n")
        return 255
    if "N" in flags:
        return 0
    env = dict(os.environ)
    if os.environ.get("FAKE_SSH_HOME"):
        env["WAVECOORD_HOME"] = os.environ["FAKE_SSH_HOME"]
    shell = os.environ.get("FAKE_SSH_SHELL") or "sh"
    if os.environ.get("FAKE_SSH_CUT"):
        data = sys.stdin.buffer.read()[:int(os.environ["FAKE_SSH_CUT"])]
        return subprocess.run([shell, "-c", cmd or "true"], env=env, input=data).returncode
    return subprocess.call([shell, "-c", cmd or "true"], env=env)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
