#!/usr/bin/env python3
"""A fake plan adapter command for tests: `plan <verb>`, JSON on stdin and stdout.

It answers from tests/fixtures/plan-adapter/*-out.json. FAKE_PLAN_LOG=<path>
appends {"verb", "stdin"} per call. FAKE_PLAN_BAD=1 prints output that breaks the
contract; FAKE_PLAN_FAIL=1 exits 1 with a message on stderr."""

import json
import os
import sys

FIX = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "fixtures", "plan-adapter")


def main(argv):
    verb = argv[0] if argv else ""
    data = json.loads(sys.stdin.read() or "{}")
    if os.environ.get("FAKE_PLAN_LOG"):
        with open(os.environ["FAKE_PLAN_LOG"], "a") as f:
            f.write(json.dumps({"verb": verb, "stdin": data}) + "\n")
    if os.environ.get("FAKE_PLAN_FAIL"):
        sys.stderr.write("tracker is down\n")
        return 1
    if os.environ.get("FAKE_PLAN_BAD"):
        print(json.dumps({"tasks": [{"id": "x"}]} if verb == "ready" else {"nope": 1}))
        return 0
    if verb not in ("ready", "get", "graph", "validate", "edit"):
        sys.stderr.write("unknown verb %s\n" % verb)
        return 2
    with open(os.path.join(FIX, verb + "-out.json")) as f:
        out = json.load(f)
    if verb == "get" and data.get("id") != out["id"]:
        sys.stderr.write("no task %s\n" % data.get("id"))
        return 1
    print(json.dumps(out))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
