{
  "$schema": "https://github.com/jellologic/wavecoord/schemas/config.schema.json",
  "coord_url": "http://127.0.0.1:18741",
  "project": "demo",
  "log_branch": "coord/log",
  "plan": {
    "adapter": "commands",
    "commands": {
      "ready": [
        "scripts/plan",
        "ready",
        "--json"
      ],
      "get": [
        "scripts/plan",
        "get"
      ],
      "graph": [
        "scripts/plan",
        "graph",
        "--json"
      ],
      "validate": [
        "scripts/plan",
        "validate"
      ],
      "edit": [
        "scripts/plan",
        "edit"
      ]
    }
  },
  "hosts": [
    {
      "name": "local",
      "slots": 2,
      "repo_path": "."
    },
    {
      "name": "build-1",
      "ssh": "builder@build-1.example.internal",
      "slots": 4,
      "repo_path": "/srv/repo",
      "env": {
        "CARGO_TARGET_DIR": "/srv/target"
      },
      "prepare_cmd": [
        "scripts/prepare-worktree"
      ],
      "claude_flags": [
        "--model",
        "opus"
      ]
    }
  ],
  "merge_cmd": [
    "gh",
    "pr",
    "merge",
    "--squash"
  ],
  "pr_cmd": [
    "gh",
    "pr",
    "create",
    "--fill"
  ],
  "check_cmd": "make test",
  "protected_paths_cmd": [
    "scripts/protected-paths"
  ],
  "wip_cap": 6,
  "branch_prefix": "wave"
}
