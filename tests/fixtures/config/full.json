{
  "$schema": "https://github.com/jellologic/wavecoord/schemas/config.schema.json",
  "coord_url": "http://127.0.0.1:18741",
  "project": "demo",
  "log_branch": "coord/log",
  "plan": {
    "adapter": "commands",
    "commands": {
      "ready": [
        "scripts/plan",
        "ready",
        "--json"
      ],
      "get": [
        "scripts/plan",
        "get"
      ],
      "graph": [
        "scripts/plan",
        "graph",
        "--json"
      ],
      "validate": [
        "scripts/plan",
        "validate"
      ],
      "edit": [
        "scripts/plan",
        "edit"
      ]
    }
  },
  "hosts": [
    {
      "name": "local",
      "slots": 2,
      "repo_path": "."
    },
    {
      "name": "build-1",
      "ssh": "builder@build-1.example.internal",
      "slots": 4,
      "repo_path": "/srv/repo",
      "env": {
        "CARGO_TARGET_DIR": "/srv/target"
      },
      "prepare_cmd": [
        "scripts/prepare-worktree"
      ],
      "claude_flags": [
        "--model",
        "opus"
      ],
      "providers": [
        "zai",
        "openrouter"
      ]
    }
  ],
  "providers": {
    "zai": {
      "env_file": "~/.config/wavecoord/providers/zai.env",
      "models": {
        "opus": "glm-5.3",
        "sonnet": "glm-5.3",
        "haiku": "glm-5.3-flash",
        "subagent": "glm-5.3-flash"
      },
      "cost_basis": "none"
    },
    "openrouter": {
      "env_file": "~/.config/wavecoord/providers/openrouter.env",
      "models": {
        "opus": "~anthropic/claude-opus-latest[1m]"
      },
      "cost_basis": "anthropic_estimate"
    }
  },
  "default_provider": "zai",
  "merge_cmd": [
    "gh",
    "pr",
    "merge",
    "--squash"
  ],
  "pr_cmd": [
    "gh",
    "pr",
    "create",
    "--fill"
  ],
  "check_cmd": "make test",
  "protected_paths_cmd": [
    "scripts/protected-paths"
  ],
  "wip_cap": 6,
  "branch_prefix": "wave",
  "fence": {
    "edit": "advisory",
    "commit": "advisory",
    "push": "enforce",
    "merge": "enforce",
    "lead": "ask"
  }
}
