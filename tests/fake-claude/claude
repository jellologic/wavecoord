#!/usr/bin/env python3
"""A fake of `claude -p` for tests. Stdlib only. It never calls a model.

It reads the prompt from the arguments or stdin and prints a result in the
same shapes as Claude Code:

  --output-format stream-json  one JSON object per line: system/init,
                               assistant, result (with structured_output)
  --output-format json         one result object
  --output-format text         the result text (default)

Flags it honors: -p/--print, --output-format, --session-id (must be a UUID),
--model. --json-schema is accepted but not read: structured_output is always
the report below. The launcher's other flags (--effort, --settings, --resume,
...) are accepted and ignored; other unknown flags are ignored too.

Environment:
  FAKE_CLAUDE_COMMIT=1     write a file in cwd and `git commit` it; the report
                           lists the commit and the file
  FAKE_CLAUDE_COMMIT_FILE=<name>  the file to write (default fake-claude-<session>.txt);
                           `{task}` is replaced by $WAVECOORD_TASK
  FAKE_CLAUDE_COMMIT_TEXT=<s>     its content (default: a line with the session id); `{task}` too
  FAKE_CLAUDE_MERGE=<ref>  first `git merge <ref>`; on a conflict, take this branch's side
                           of every file and commit the merge (a resolver)
  FAKE_CLAUDE_STATUS=<s>   report status (default done)
  FAKE_CLAUDE_REPORT=<p>   use the JSON file at <p> as structured_output
  FAKE_CLAUDE_EXIT=<n>     exit code (default 0); non-zero gives is_error
  FAKE_CLAUDE_SLEEP=<s>    sleep before the result (seconds, float)
  FAKE_CLAUDE_COST=<usd>   total_cost_usd (default 0.0)
  FAKE_CLAUDE_DUMP=<p>     write {"argv", "env" (WAVECOORD_* and CLAUDE* keys), "cwd", "stdin"} to <p>
  FAKE_CLAUDE_EVENTS=<p>   a JSONL file; each line goes into the stream-json output before the result
  FAKE_CLAUDE_EARLY_EVENTS=<p>  a JSONL file; its lines go out (flushed) at start, before FAKE_CLAUDE_SLEEP
  FAKE_CLAUDE_STDERR=<s>   write <s> as a line to stderr first (like a provider's model warning)
  FAKE_CLAUDE_EDIT=<path>  emulate one Edit tool call on <path> before the result: run the PreToolUse
                           hooks of --plugin-dir (and of FAKE_CLAUDE_EXTRA_HOOKS, a hooks.json file) as
                           Claude Code does (exec form, timeout, onFailure "block", exit 2 = deny,
                           deny > defer > ask > allow; "ask" is a deny in -p mode), write the file only
                           when the call is allowed, and add {"type": "fake_tool", ...} to the stream
  FAKE_CLAUDE_VERSION=<v>  what --version prints (default "0.0.0 (fake-claude)")
  FAKE_CLAUDE_EXPECT_ENV=<p>  a JSON object {KEY: value}; a null value means KEY must be absent.
                           On a mismatch: print the KEY names to stderr and exit 3 (is_error)
  FAKE_CLAUDE_MODES=<p>    a JSON file of per-run modes, read at each run (so a test can change it
                           between runs). The first key that exists wins:
                             "<task>:resolve"     when the prompt is a resolver brief
                             "<task>@<provider>"  provider: $FAKE_PROVIDER (set it in a provider env
                                                  file), else "anthropic"
                             "<task>", "*"
                           A mode is an object with any of:
                             "commit": {"<path>": "<text>", ...}  write the files, one commit
                             "merge": "<ref>"     as FAKE_CLAUDE_MERGE (before "commit")
                             "report": {...}      keys merged over the default report
                             "rate_limit": true   a rejected rate_limit_event, then exit 1
                             "wait_for": "<path>" wait (at most 120 s) until the file exists
                             "send": "<text>"     POST /api/messages to the lead as this worker
                                                  ($WAVECOORD_URL, $WAVECOORD_TOKEN_FILE, $WAVECOORD_AGENT_ID)
                             "sleep", "exit", "cost"  as the variables above
  FAKE_CLAUDE_RUNS=<p>     append one JSON line per run: {task, attempt, provider, mode, cwd, branch}
"""

import argparse
import json
import os
import subprocess
import sys
import time
import uuid

VERSION = os.environ.get("FAKE_CLAUDE_VERSION") or "0.0.0 (fake-claude)"


def parse(argv):
    ap = argparse.ArgumentParser(prog="claude", add_help=False)
    ap.add_argument("-p", "--print", action="store_true", dest="print_mode")
    ap.add_argument("--output-format", default="text", choices=["text", "json", "stream-json"])
    ap.add_argument("--session-id")
    ap.add_argument("--model", default="fake-model")
    ap.add_argument("--json-schema")
    ap.add_argument("--verbose", action="store_true")
    ap.add_argument("--version", action="store_true")
    # flags with a value that the fake ignores (so the value is never read as the prompt)
    for flag in ("--effort", "--max-turns", "--max-budget-usd", "--fallback-model", "--plugin-dir",
                 "--settings", "--append-system-prompt", "--append-system-prompt-file", "--resume",
                 "--permission-mode", "--allowedTools", "--disallowedTools", "--input-format", "--mcp-config"):
        ap.add_argument(flag)
    ap.add_argument("--include-hook-events", action="store_true")
    ap.add_argument("prompt", nargs="?")
    args, _unknown = ap.parse_known_args(argv)
    return args


def git_env():
    env = dict(os.environ)
    env.setdefault("GIT_AUTHOR_NAME", "fake-claude")
    env.setdefault("GIT_AUTHOR_EMAIL", "fake-claude@example.invalid")
    env.setdefault("GIT_COMMITTER_NAME", env["GIT_AUTHOR_NAME"])
    env.setdefault("GIT_COMMITTER_EMAIL", env["GIT_AUTHOR_EMAIL"])
    return env


def git_merge(ref):
    """Merge `ref`; on a conflict keep this branch's side and commit. -> the merge commit or None."""
    env = git_env()
    p = subprocess.run(["git", "merge", "--no-edit", "-q", ref], env=env, stdout=subprocess.PIPE,
                       stderr=subprocess.PIPE)
    if p.returncode != 0:
        files = subprocess.run(["git", "diff", "--name-only", "--diff-filter=U"], env=env, check=True,
                               stdout=subprocess.PIPE, universal_newlines=True).stdout.split()
        for f in files:
            subprocess.run(["git", "checkout", "--ours", "--", f], env=env, check=True)
            subprocess.run(["git", "add", "--", f], env=env, check=True)
        subprocess.run(["git", "commit", "-q", "--no-edit"], env=env, check=True)
    return subprocess.run(["git", "rev-parse", "HEAD"], check=True, env=env,
                          stdout=subprocess.PIPE, universal_newlines=True).stdout.strip()


def git_commit(session_id):
    name = os.environ.get("FAKE_CLAUDE_COMMIT_FILE") or "fake-claude-%s.txt" % session_id[:8]
    task = os.environ.get("WAVECOORD_TASK", "task")
    name = name.replace("{task}", task)
    if os.path.dirname(name):
        os.makedirs(os.path.dirname(name), exist_ok=True)
    with open(name, "w", encoding="utf-8") as f:
        text = os.environ.get("FAKE_CLAUDE_COMMIT_TEXT") or "written by fake claude, session %s\n" % session_id
        f.write(text.replace("{task}", task))
    env = dict(os.environ)
    env.setdefault("GIT_AUTHOR_NAME", "fake-claude")
    env.setdefault("GIT_AUTHOR_EMAIL", "fake-claude@example.invalid")
    env.setdefault("GIT_COMMITTER_NAME", env["GIT_AUTHOR_NAME"])
    env.setdefault("GIT_COMMITTER_EMAIL", env["GIT_AUTHOR_EMAIL"])
    subprocess.run(["git", "add", "--", name], check=True, env=env)
    subprocess.run(["git", "commit", "-q", "-m", "fake claude: " + name], check=True, env=env)
    sha = subprocess.run(["git", "rev-parse", "HEAD"], check=True, env=env,
                         stdout=subprocess.PIPE, universal_newlines=True).stdout.strip()
    return sha, name


def mode_for(prompt):
    """(key, mode) from FAKE_CLAUDE_MODES, or (None, {})."""
    path = os.environ.get("FAKE_CLAUDE_MODES")
    if not path:
        return None, {}
    with open(path, encoding="utf-8") as f:
        modes = json.load(f)
    task = os.environ.get("WAVECOORD_TASK", "task")
    provider = os.environ.get("FAKE_PROVIDER") or "anthropic"
    keys = []
    if prompt.lstrip().startswith("# Resolve merge conflicts"):
        keys.append(task + ":resolve")
    keys += [task + "@" + provider, task, "*"]
    for k in keys:
        if k in modes:
            return k, modes[k]
    return None, {}


def send_to_lead(text):
    import urllib.request
    url = os.environ["WAVECOORD_URL"].rstrip("/") + "/api/messages"
    with open(os.environ["WAVECOORD_TOKEN_FILE"], encoding="utf-8") as f:
        token = f.read().strip()
    req = urllib.request.Request(url, data=json.dumps({"to": {"kind": "lead"}, "body": text}).encode("utf-8"),
                                 method="POST", headers={"Content-Type": "application/json",
                                                         "Authorization": "Bearer " + token,
                                                         "X-Wavecoord-Agent": os.environ["WAVECOORD_AGENT_ID"]})
    with urllib.request.urlopen(req, timeout=10) as r:
        r.read()


def commit_files(files, session_id):
    env = git_env()
    for name, text in sorted(files.items()):
        if os.path.dirname(name):
            os.makedirs(os.path.dirname(name), exist_ok=True)
        with open(name, "w", encoding="utf-8") as f:
            f.write(text)
        subprocess.run(["git", "add", "--", name], check=True, env=env)
    subprocess.run(["git", "commit", "-q", "-m", "fake claude: %s (%s)" % (", ".join(sorted(files)), session_id[:8])],
                   check=True, env=env)
    return subprocess.run(["git", "rev-parse", "HEAD"], check=True, env=env,
                          stdout=subprocess.PIPE, universal_newlines=True).stdout.strip()


def report_for(prompt, session_id, mode=None):
    mode = mode or {}
    path = os.environ.get("FAKE_CLAUDE_REPORT")
    if path:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    first = (prompt.strip().splitlines() or [""])[0][:200]
    rep = {
        "status": os.environ.get("FAKE_CLAUDE_STATUS", "done"),
        "summary": "fake claude handled: " + (first or "(empty prompt)"),
        "commits": [],
        "files": [],
        "checks_run": [],
        "acceptance_met": True,
        "questions": [],
        "proposals": [],
        "plan_feedback": "",
        "risks_hit": [],
    }
    if mode.get("status"):
        rep["status"] = mode["status"]
    merge = mode.get("merge") or os.environ.get("FAKE_CLAUDE_MERGE")
    if merge:
        rep["commits"].append(git_merge(merge))
    if mode.get("commit"):
        rep["commits"].append(commit_files(mode["commit"], session_id))
        rep["files"] += sorted(mode["commit"])
    rep.update(mode.get("report") or {})
    if os.environ.get("FAKE_CLAUDE_COMMIT") == "1":
        sha, name = git_commit(session_id)
        rep["commits"].append(sha)
        rep["files"].append(name)
    return rep


DECISION_ORDER = ("deny", "defer", "ask", "allow")


def _hook_groups(path):
    try:
        with open(path, encoding="utf-8") as f:
            return (json.load(f).get("hooks") or {}).get("PreToolUse") or []
    except (OSError, ValueError):
        return []


def run_pre_tool_use(plugin_dir, tool, file_path, session_id):
    """-> (decision, [reasons]) for one tool call, the way Claude Code combines PreToolUse hooks."""
    import re
    sources = []
    if plugin_dir:
        sources.append((plugin_dir, os.path.join(plugin_dir, "hooks", "hooks.json")))
    if os.environ.get("FAKE_CLAUDE_EXTRA_HOOKS"):
        sources.append((os.path.dirname(os.environ["FAKE_CLAUDE_EXTRA_HOOKS"]), os.environ["FAKE_CLAUDE_EXTRA_HOOKS"]))
    inp = json.dumps({"session_id": session_id, "cwd": os.getcwd(), "hook_event_name": "PreToolUse",
                      "tool_name": tool, "tool_input": {"file_path": file_path}, "permission_mode": "default"})
    decisions, reasons = [], []
    for root, path in sources:
        for group in _hook_groups(path):
            if group.get("matcher") and not re.fullmatch(group["matcher"], tool):
                continue
            for h in group.get("hooks") or []:
                cmd = h["command"].replace("${CLAUDE_PLUGIN_ROOT}", root)
                argv = [cmd] + list(h.get("args") or []) if h.get("args") is not None else ["sh", "-c", cmd]
                env = dict(os.environ, CLAUDE_PLUGIN_ROOT=root)
                block = h.get("onFailure") == "block"
                try:
                    p = subprocess.run(argv, input=inp, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                       universal_newlines=True, timeout=float(h.get("timeout", 600)), env=env)
                except (OSError, subprocess.TimeoutExpired) as e:
                    if block:
                        decisions.append("deny")
                        reasons.append("hook failed: %s" % type(e).__name__)
                    continue
                if p.returncode == 2:
                    decisions.append("deny")
                    reasons.append(p.stderr.strip())
                    continue
                if p.returncode != 0:
                    if block:
                        decisions.append("deny")
                        reasons.append("hook exit %s" % p.returncode)
                    continue
                if not p.stdout.strip():
                    continue
                try:
                    out = json.loads(p.stdout)
                except ValueError:
                    if block:
                        decisions.append("deny")
                        reasons.append("hook output is not JSON")
                    continue
                d = (out.get("hookSpecificOutput") or {}).get("permissionDecision")
                if d in DECISION_ORDER:
                    decisions.append(d)
                    reasons.append((out.get("hookSpecificOutput") or {}).get("permissionDecisionReason") or "")
    for d in DECISION_ORDER:
        if d in decisions:
            return ("deny" if d == "ask" else d), reasons  # -p mode: nobody answers an ask
    return "allow", reasons


def main(argv):
    args = parse(argv)
    if args.version:
        print(VERSION)
        return 0
    if args.session_id:
        try:
            session_id = str(uuid.UUID(args.session_id))
        except ValueError:
            sys.stderr.write("Error: Invalid session ID. Must be a valid UUID.\n")
            return 1
    else:
        session_id = str(uuid.uuid4())

    prompt = args.prompt if args.prompt is not None else ""
    if not sys.stdin.isatty():
        data = sys.stdin.read()
        prompt = (prompt + "\n" + data) if prompt else data

    if os.environ.get("FAKE_CLAUDE_DUMP"):
        keep = {k: v for k, v in os.environ.items()
                if k.startswith(("WAVECOORD_", "CLAUDE", "ANTHROPIC_")) or k == "API_TIMEOUT_MS"}
        with open(os.environ["FAKE_CLAUDE_DUMP"], "w", encoding="utf-8") as f:
            json.dump({"argv": argv, "env": keep, "cwd": os.getcwd(), "stdin": prompt}, f)

    if os.environ.get("FAKE_CLAUDE_STDERR"):
        sys.stderr.write(os.environ["FAKE_CLAUDE_STDERR"] + "\n")
        sys.stderr.flush()
    env_errors = []
    if os.environ.get("FAKE_CLAUDE_EXPECT_ENV"):
        with open(os.environ["FAKE_CLAUDE_EXPECT_ENV"], encoding="utf-8") as f:
            for k, want in json.load(f).items():
                if os.environ.get(k) != want:
                    env_errors.append(k)
        if env_errors:
            sys.stderr.write("fake claude: unexpected env: %s\n" % ", ".join(sorted(env_errors)))

    mode_key, mode = mode_for(prompt)
    if os.environ.get("FAKE_CLAUDE_RUNS"):
        with open(os.environ["FAKE_CLAUDE_RUNS"], "a", encoding="utf-8") as f:
            f.write(json.dumps({"task": os.environ.get("WAVECOORD_TASK"), "attempt": os.environ.get("WAVECOORD_ATTEMPT"),
                                "provider": os.environ.get("FAKE_PROVIDER") or "anthropic", "mode": mode_key,
                                "cwd": os.getcwd(), "branch": os.environ.get("WAVECOORD_BRANCH")}) + "\n")
    started = time.time()
    if os.environ.get("FAKE_CLAUDE_EARLY_EVENTS"):
        with open(os.environ["FAKE_CLAUDE_EARLY_EVENTS"], encoding="utf-8") as f:
            for ln in f:
                if ln.strip():
                    sys.stdout.write(ln.rstrip("\n") + "\n")
        sys.stdout.flush()
    if mode.get("send"):
        send_to_lead(mode["send"])
    if mode.get("wait_for"):
        end = time.time() + 120
        while not os.path.exists(mode["wait_for"]) and time.time() < end:
            time.sleep(0.1)
    sleep = mode.get("sleep") or os.environ.get("FAKE_CLAUDE_SLEEP")
    if sleep:
        time.sleep(float(sleep))
    exit_code = 3 if env_errors else int(mode.get("exit") or os.environ.get("FAKE_CLAUDE_EXIT", "0"))
    if mode.get("rate_limit") and not exit_code:
        exit_code = 1
    tool_event = None
    if os.environ.get("FAKE_CLAUDE_EDIT"):
        target = os.environ["FAKE_CLAUDE_EDIT"]
        decision, reasons = run_pre_tool_use(args.plugin_dir, "Edit", target, session_id)
        if decision in ("allow", "defer"):
            with open(target, "a", encoding="utf-8") as f:
                f.write("edited by fake claude\n")
        tool_event = {"type": "fake_tool", "tool": "Edit", "path": target, "decision": decision, "reasons": reasons}
    structured = report_for(prompt, session_id, mode)
    text = str(structured.get("summary") or "fake claude done")
    usage = {"input_tokens": len(prompt.split()), "output_tokens": len(text.split()),
             "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0}
    result = {
        "type": "result",
        "subtype": "success" if exit_code == 0 else "error_during_execution",
        "is_error": exit_code != 0,
        "duration_ms": int((time.time() - started) * 1000),
        "duration_api_ms": 0,
        "num_turns": 1,
        "result": text,
        "session_id": session_id,
        "total_cost_usd": float(mode.get("cost") or os.environ.get("FAKE_CLAUDE_COST", "0")),
        "usage": usage,
        "modelUsage": {args.model: {"inputTokens": usage["input_tokens"], "outputTokens": usage["output_tokens"],
                                    "cacheReadInputTokens": 0, "cacheCreationInputTokens": 0, "costUSD": 0.0}},
    }
    result["structured_output"] = structured

    out = sys.stdout
    if args.output_format == "stream-json":
        lines = [
            {"type": "system", "subtype": "init", "session_id": session_id, "cwd": os.getcwd(),
             "model": args.model, "tools": [], "mcp_servers": [], "permissionMode": "default",
             "apiKeySource": "none", "claude_code_version": VERSION},
            {"type": "assistant", "session_id": session_id, "parent_tool_use_id": None,
             "message": {"id": "msg_fake_" + session_id[:8], "type": "message", "role": "assistant",
                         "model": args.model, "content": [{"type": "text", "text": text}],
                         "stop_reason": "end_turn", "usage": usage}},
        ]
        if tool_event:
            lines.append(tool_event)
        if os.environ.get("FAKE_CLAUDE_EVENTS"):
            with open(os.environ["FAKE_CLAUDE_EVENTS"], encoding="utf-8") as f:
                lines += [json.loads(l) for l in f if l.strip()]
        if mode.get("rate_limit"):
            lines.append({"type": "rate_limit_event", "session_id": session_id,
                          "rate_limit_info": {"status": "rejected", "rateLimitType": "five_hour"}})
        lines.append(result)
        for obj in lines:
            out.write(json.dumps(obj) + "\n")
            out.flush()
    elif args.output_format == "json":
        out.write(json.dumps(result) + "\n")
    else:
        out.write(text + "\n")
    return exit_code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
