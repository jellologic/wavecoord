{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/jellologic/wavecoord/schemas/spec-ops.schema.json",
  "title": "wavecoord spec tree ops",
  "description": "The op API of the spec tree (docs/design/spec-layer.md, section 9.3): the input of `wavecoord spec apply` and of the lead's spec_edit tool.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ops"],
  "properties": {
    "ops": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/op"}},
    "branch": {"type": "string"},
    "title": {"type": "string"},
    "body": {"type": "string"}
  },
  "definitions": {
    "id": {"type": "string", "minLength": 1, "maxLength": 400},
    "op": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["op", "id"],
         "properties": {"op": {"const": "create"}, "id": {"$ref": "#/definitions/id"},
                        "kind": {"enum": ["capability", "feature", "requirement", "task", "decision"]},
                        "fields": {"type": "object"}, "sections": {"type": "object"}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "id", "key"],
         "properties": {"op": {"const": "set"}, "id": {"$ref": "#/definitions/id"}, "key": {"type": "string"},
                        "value": {}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "id", "status"],
         "properties": {"op": {"const": "set_status"}, "id": {"$ref": "#/definitions/id"}, "status": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "id", "section"],
         "properties": {"op": {"const": "set_section"}, "id": {"$ref": "#/definitions/id"},
                        "section": {"type": "string"}, "value": {}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "id", "key", "value"],
         "properties": {"op": {"enum": ["add", "remove"]}, "id": {"$ref": "#/definitions/id"},
                        "key": {"type": "string"}, "value": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "id", "list", "artifact"],
         "properties": {"op": {"const": "set_artifact"}, "id": {"$ref": "#/definitions/id"},
                        "list": {"enum": ["inputs", "outputs"]}, "artifact": {"type": "object"}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "id", "list", "artifact"],
         "properties": {"op": {"const": "remove_artifact"}, "id": {"$ref": "#/definitions/id"},
                        "list": {"enum": ["inputs", "outputs"]}, "artifact": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "id", "name", "steps"],
         "properties": {"op": {"const": "set_scenario"}, "id": {"$ref": "#/definitions/id"},
                        "name": {"type": "string", "minLength": 1}, "steps": {"type": "array", "minItems": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "id", "name"],
         "properties": {"op": {"const": "remove_scenario"}, "id": {"$ref": "#/definitions/id"},
                        "name": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "from", "to"],
         "properties": {"op": {"const": "mv"}, "from": {"$ref": "#/definitions/id"}, "to": {"$ref": "#/definitions/id"}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "task"],
         "properties": {"op": {"const": "rebase_basis"}, "task": {"$ref": "#/definitions/id"}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "old", "new"],
         "properties": {"op": {"const": "supersede"}, "old": {"$ref": "#/definitions/id"}, "new": {"$ref": "#/definitions/id"}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "id"],
         "properties": {"op": {"const": "delete"}, "id": {"$ref": "#/definitions/id"}, "force": {"type": "boolean"}}}
      ]
    }
  }
}
